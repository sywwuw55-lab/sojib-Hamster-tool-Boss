#!/bin/bash

# Load configuration if available
if [ -f "$HOME/sojib-Hamster-tool-Boss/config.cfg" ]; then
    source "$HOME/sojib-Hamster-tool-Boss/config.cfg"
else
    echo "[!] Error: config.cfg not found!"
    exit 1
fi

# Security check logic
DEVICE_ID_FILE="$HOME/.rabbit_data/device_id"
mkdir -p "$(dirname "$DEVICE_ID_FILE")"

if [ ! -f "$DEVICE_ID_FILE" ]; then
    uuidgen > "$DEVICE_ID_FILE" 2>/dev/null || cat /proc/sys/kernel/random/uuid > "$DEVICE_ID_FILE" 2>/dev/null || date +%s%N > "$DEVICE_ID_FILE"
fi

UNIQUE_ID=$(cat "$DEVICE_ID_FILE" | tr -d '[:space:]')
USER_DB="$HOME/sojib-Hamster-tool-Boss/users_list.txt"

if [ ! -f "$USER_DB" ]; then
    touch "$USER_DB"
fi

CURRENT_STATUS=$(grep "^$UNIQUE_ID" "$USER_DB" | tail -n 1 | cut -d'|' -f2 | tr -d '[:space:]')

if [ "$CURRENT_STATUS" = "blocked" ]; then
    echo -e "\n[!] ACCESS DENIED: Your account has been BLOCKED by Admin!\n"
    exit 1
fi

if [ -z "$CURRENT_STATUS" ]; then
    echo "$UNIQUE_ID|active|2030-01-01" >> "$USER_DB"
    curl -s -X POST "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" \
        -d chat_id="$CHAT_ID" \
        -d text="🚨 নতুন কেউ আপনার টুলটি রান করেছে!%0A%0A🆔 ইউনিক আইডি: $UNIQUE_ID%0A📱 ডিভাইস: $(uname -o) $(uname -n)%0A⏰ সময়: $(date)" > /dev/null
fi

echo "[+] Access Granted. Starting tool..."
# আপনার মূল টুলের কোড এখানে থাকবে
